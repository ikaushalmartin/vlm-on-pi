# Copy to .env and edit.
# Camera: /dev/video0 (USB webcam), rtsp://user:pass@ip/stream (network camera),
# /data/clip.mp4 (a recording played on a loop, as if it were a camera),
# or folder:/data/demo (cycle through photos, no live view).
CAMERA=/dev/video0
# Live view size and frame rate (the page's video, not what the model sees).
LIVE_WIDTH=640
LIVE_FPS=10
# Shown on the page, e.g. to credit a recording you're playing.
CAMERA_CREDIT=
# Seconds between looks. One look takes 40-90 s on a Pi 4.
SCAN_EVERY_S=180
# Longest side of the photo sent to the model, in pixels.
IMAGE_SIZE=512
# Zoom-in pass: re-ask on a crop around each box for tighter boxes
# (~12 s per item found on a Pi 4). 0 turns it off.
BOX_ZOOM=1
# Image tokens per photo: fewer is faster but less detailed (32-256).
IMAGE_MAX_TOKENS=256
# Days of history to keep. Each item's latest sighting is always kept.
KEEP_DAYS=7
